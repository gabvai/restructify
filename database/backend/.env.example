PORT=4000
NODE_ENV=development
PUBLIC_API_URL=http://localhost:4000

# Production (Render): https://restructify.onrender.com
# Vercel frontend build needs the same URL as VITE_API_URL in frontend/.env

# Supabase Storage (required on Render — local disk uploads are wiped on redeploy)
# Dashboard → Project Settings → API → Project URL + service_role key (secret, backend only)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_STORAGE_BUCKET_LISTING=listing-images
SUPABASE_STORAGE_BUCKET_DRAWINGS=drawings

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=restructify
DB_SSL=false

JWT_SECRET=change_me_to_long_random_secret
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10
AI_SERVICE_URL=http://localhost:8001